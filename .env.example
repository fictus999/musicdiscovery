# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/musicdiscovery

# --- Spotify (Client Credentials only in Phase 1; Authorization Code is feature-flagged) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_AUTH_CODE_ENABLED=false

# --- Apple Music / MusicKit (stub until Phase 0 entitlement validation) ---
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_MUSICKIT_ENABLED=false

# --- MusicBrainz (ingestion + fallback lookups only, never live per-request search) ---
MUSICBRAINZ_USER_AGENT=music-discovery/0.1.0 (contact@example.com)
MUSICBRAINZ_DUMP_URL=https://data.metabrainz.org/pub/musicbrainz/data/fullexport/

# --- Cover Art Archive ---
COVER_ART_ARCHIVE_BASE_URL=https://coverartarchive.org

# --- App ---
APP_ENV=development
SECRET_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Observability ---
SENTRY_DSN=
POSTHOG_API_KEY=
